# systemd サービス定義: ハートピア収穫物検索 Discord Bot
#
# 使い方はリポジトリ直下の「ラズパイ移行ガイド.md」を参照。
# ※ User と パスの「mia」の部分は、ラズパイのユーザー名に合わせてあります。別のユーザーで動かす場合は書き換えてください。

[Unit]
Description=Heartopia Harvest Search Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mia
WorkingDirectory=/home/mia/mhr-heartopia-bot
ExecStart=/home/mia/mhr-heartopia-bot/.venv/bin/python bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
